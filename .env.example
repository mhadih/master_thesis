# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored and never committed.

# S03 / code_recorder database (used by src/data_collection/*)
CODE_RECORDER_DBNAME=code_recorder
CODE_RECORDER_USER=
CODE_RECORDER_PASSWORD=
CODE_RECORDER_HOST=localhost
CODE_RECORDER_PORT=5432

# S04 local database (used by S04/edit_distance.py and S04/dump_db.py)
S04_DBNAME=code_recorder_s04
S04_USER=
S04_PASSWORD=
S04_HOST=localhost
S04_PORT=5432

# Remote LMS database (used by S04/dump_db.py only)
REMOTE_DBNAME=
REMOTE_USER=
REMOTE_PASSWORD=
REMOTE_HOST=
REMOTE_PORT=
